[Unit]
Description=YumiOS - detect the boards and install the matching printer.cfg
# Runs once per boot, before Klipper opens the serial ports. compose.py leaves printer.cfg
# untouched when the boards have not changed since the last boot (.detected_hardware.json).
# @PROJECT_DIR@ is the yumi-config checkout, rendered by install.sh.
Before=klipper.service
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
ConditionPathExists=@PROJECT_DIR@/generator/autoconfig.py

[Service]
Type=oneshot
User=pi
Group=pi
ExecStart=/usr/bin/python3 @PROJECT_DIR@/generator/autoconfig.py --boot
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
